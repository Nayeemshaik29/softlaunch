# Our Spring Cloud gateway (all API calls go here). Copy to .env.local.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Where signed photo links point (RustFS locally, S3 in production). Used for the Content-Security-Policy.
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:9000
# Sign in with Google: the same OAuth "Web application" client ID as GOOGLE_CLIENT_IDS in the root .env.
# Public, not a secret. Empty = no Google button. In Google Cloud, add http://localhost:3030 to
# "Authorized JavaScript origins" (and your real domain later).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
