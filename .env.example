# Copy to .env (git-ignored) and fill in real values:   cp .env.example .env
# Generate a secret with:                                 openssl rand -base64 32
JWT_SECRET=

# Local photo storage (RustFS): any values, e.g. a long random secret
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Local infrastructure passwords: long random values (e.g. openssl rand -base64 24)
DB_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Email (account-deletion links). Leave empty locally: Mailpit catches everything at http://localhost:8025
# Production: SMTP login from your email provider (Amazon SES, Brevo, ...)
MAIL_USERNAME=
MAIL_PASSWORD=

# Web app address(es) allowed to call the API from a browser (CORS). Comma-separated.
# capacitor://localhost (iOS app) and https://localhost (Android app) are the phone apps' own origins.
WEB_ORIGINS=http://localhost:3030,capacitor://localhost,https://localhost
# Payments: mock (fake checkout, local/CI) or razorpay. Razorpay keys from dashboard.razorpay.com
# (Settings → API keys, TEST mode first). The key secret and webhook secret must never be committed.
BILLING_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Refresh-token cookie only over HTTPS. Keep false locally (http://localhost); MUST be true in production.
REFRESH_COOKIE_SECURE=false

# Sign in with Google: your OAuth "Web application" client ID from console.cloud.google.com
# (APIs & Services → Credentials). Public, not a secret. Leave empty to hide the Google button.
# The web app needs the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID (web/.env.local).
GOOGLE_CLIENT_IDS=

# Calls: shared secret between chat-service and the coturn relay (openssl rand -base64 32). Never commit it.
TURN_SECRET=
# Public IP of the machine running coturn (production). Locally 127.0.0.1 is fine.
TURN_EXTERNAL_IP=127.0.0.1
